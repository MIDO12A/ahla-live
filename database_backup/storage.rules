rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // روابط عامة للقراءة (getPublicUrl تُستخدم بدون مصادقة في الصور)
    allow read: if true;

    // الكتابة فقط للمستخدمين المسجلين داخل مسار الوكالات أو مجلدات المستخدم
    match /{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}
